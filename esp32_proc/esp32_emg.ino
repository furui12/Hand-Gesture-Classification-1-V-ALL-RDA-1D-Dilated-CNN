void extract_cnn_features(const float* ch1, const float* ch2, int n, float* out_features) {
    // Channel 1 fills indices 0-9
    extract_single_channel_cnn_features(ch1, n, &out_features[0]);
    // Channel 2 fills indices 10-19
    extract_single_channel_cnn_features(ch2, n, &out_features[10]);
}

// --- Arduino Setup & Loop ---

void setup() {
    Serial.begin(115200);
    while (!Serial);

    // Initialize dummy data
    // COMMENT OUT WHEN YOU HAVE REAL DATA OR DATA STREAM FROM EMG SENSORS!!!
    for (int w = 0; w < NUM_WINDOWS; w++) {
        for (int ch = 0; ch < 2; ch++) {
            for (int s = 0; s < SAMPLES_PER_WINDOW; s++) {
                sample_windows[w][ch][s] = ((float)rand() / RAND_MAX) * 0.05f;
            }
        }
    }

    static tflite::MicroErrorReporter micro_error_reporter;
    error_reporter = &micro_error_reporter;
    static tflite::AllOpsResolver resolver;

    // --- SETUP MODEL 1 (RDA) ---
    model_rda = tflite::GetModel(gesture_rda_model_tflite);
    static tflite::MicroInterpreter static_interpreter_rda(
        model_rda, resolver, tensor_arena_rda, kTensorArenaSizeRDA, error_reporter);
    interpreter_rda = &static_interpreter_rda;
    interpreter_rda->AllocateTensors();
    input_rda = interpreter_rda->input(0);
    output_rda = interpreter_rda->output(0);

    // --- SETUP MODEL 2 (CNN) ---
    model_cnn = tflite::GetModel(emg_gesture_dilated_cnn_tflite);
    static tflite::MicroInterpreter static_interpreter_cnn(
        model_cnn, resolver, tensor_arena_cnn, kTensorArenaSizeCNN, error_reporter);
    interpreter_cnn = &static_interpreter_cnn;
    interpreter_cnn->AllocateTensors();
    input_cnn = interpreter_cnn->input(0);
    output_cnn = interpreter_cnn->output(0);

    Serial.println("Dual-Model setup complete. Starting inference loop...");

    // Initialize each pin on its own independent hardware channel
    for (int i = 0; i < numServos; i++) {
        ledcSetup(ledcChannels[i], freq, resolution);
        ledcAttachPin(servoPins[i], ledcChannels[i]);
        // Initialize all motors to 90 degrees (mid-point)
        // writeServoAngle(i, 90);
    }
}


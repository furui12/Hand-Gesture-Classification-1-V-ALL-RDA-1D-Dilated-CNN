            }
        }

        delay(2000);

        switch (final_prediction) {
            case 0:
                cylindricalWrap();
                break;
            case 1:
                keyPinch();
                break;
            case 2:
                pulpPinch();
                break;
            case 3:
                tripodPinch();
                break;
            case 4:
                restGesture();
                break;
            default:
                break;
        }

        delay(2000);
        restGesture();
    }

    // Serial.println("\nDemonstration complete. Halting.");
    // while(true){ delay(1000); }
}

void defaultHand() {
    writeServoAngle(0, 90);
    writeServoAngle(1, 90);
    writeServoAngle(2, 90);
    writeServoAngle(3, 90);
    writeServoAngle(4, 90);
    // writeServoAngle(5, 90);
}

void restGesture() {
    writeServoAngle(0, 60);
    writeServoAngle(1, 60);
    writeServoAngle(2, 110);
    writeServoAngle(3, 110);
    writeServoAngle(4, 110);
    // writeServoAngle(5, 90);
    delay(750);
    writeServoAngle(0, 70);
    writeServoAngle(1, 70);
    writeServoAngle(2, 100);
    writeServoAngle(3, 100);
    writeServoAngle(4, 100);
}

void cylindricalWrap() {
    writeServoAngle(0, 150);
    writeServoAngle(1, 150);
    writeServoAngle(2, 30);
    writeServoAngle(3, 30);
    writeServoAngle(4, 30);
    // writeServoAngle(5, 90);
}

void keyPinch() {
    writeServoAngle(0, 175);
    writeServoAngle(1, 180);
    writeServoAngle(2, 0);
    writeServoAngle(3, 0);
    writeServoAngle(4, 0);
    // writeServoAngle(5, 90);
}

void pulpPinch() {
    writeServoAngle(0, 175);
    writeServoAngle(1, 180);
    writeServoAngle(2, 100);
    writeServoAngle(3, 100);
    writeServoAngle(4, 100);
    // writeServoAngle(5, 0);
}

void tripodPinch() {
    writeServoAngle(0, 175);
    writeServoAngle(1, 180);
    writeServoAngle(2, 0);
    writeServoAngle(3, 100);
    writeServoAngle(4, 100);
    // writeServoAngle(5, 0);
}

// Custom function to handle writing standard angles (0 to 180)
void writeServoAngle(int servoIndex, int angle) {
    // Constrain angle to prevent mechanical strain
    angle = constrain(angle, 0, 180);
    
    // Map 0-180 degrees to the 14-bit duty cycle values
    int duty = map(angle, 0, 180, minDuty, maxDuty);
    
    // Write directly to the hardware channel
    ledcWrite(ledcChannels[servoIndex], duty);
}

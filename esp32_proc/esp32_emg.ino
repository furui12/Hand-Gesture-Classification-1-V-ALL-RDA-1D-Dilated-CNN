// --- Feature Extraction Math ---

float calculate_rms(const float* x, int n) {
    float sum_sq = 0.0f;
    for (int i = 0; i < n; i++) sum_sq += x[i] * x[i];
    return sqrt(sum_sq / n);
}

float calculate_wamp(const float* x, int n, float threshold = 0.01f) {
    float count = 0.0f;
    for (int i = 1; i < n; i++) {
        if (fabs(x[i] - x[i - 1]) > threshold) count += 1.0f;
    }
    return count;
}

float calculate_log_var(const float* x, int n) {
    float mean = 0.0f;
    for (int i = 0; i < n; i++) mean += x[i];
    mean /= n;
    float sum_sq_diff = 0.0f;
    for (int i = 0; i < n; i++) {
        float diff = x[i] - mean;
        sum_sq_diff += diff * diff;
    }
    return log((sum_sq_diff / n) + 1e-8f);
}

void calculate_ar_coeffs(const float* x, int n, int order, float* ar_out) {
    float r[5] = {0};
    for (int i = 0; i <= order; i++) {
        for (int j = 0; j < n - i; j++) r[i] += x[j] * x[j + i];
    }
    if (r[0] == 0.0f) {
        for (int i = 0; i < order; i++) ar_out[i] = 0.0f;
        return;
    }
    float a[5][5] = {0}, e[5] = {0};
    e[0] = r[0];
    for (int i = 1; i <= order; i++) {
        float sum = 0.0f;
        for (int j = 1; j < i; j++) sum += a[i - 1][j] * r[i - j];
        float k = (r[i] - sum) / e[i - 1];
        a[i][i] = k;
        for (int j = 1; j < i; j++) a[i][j] = a[i - 1][j] - k * a[i - 1][i - j];
        e[i] = (1.0f - k * k) * e[i - 1];
    }
    for (int i = 1; i <= order; i++) ar_out[i - 1] = -a[order][i];
}

// CNN Specific Features
float calculate_mav(const float* x, int n) {
    float sum = 0.0f;
    for (int i = 0; i < n; i++) sum += fabs(x[i]);
    return sum / n;
}

float calculate_wl(const float* x, int n) {
    float sum = 0.0f;
    for (int i = 1; i < n; i++) sum += fabs(x[i] - x[i - 1]);
    return sum;
}

float calculate_zc(const float* x, int n, float threshold = 0.01f) {
    float count = 0.0f;
    for (int i = 1; i < n; i++) {
        float sign_prev = (x[i-1] > 0) - (x[i-1] < 0);
        float sign_curr = (x[i] > 0) - (x[i] < 0);
        if (sign_curr != sign_prev && fabs(x[i] - x[i-1]) > threshold) count += 1.0f;
    }
    return count;
}

float calculate_ssc(const float* x, int n, float threshold = 0.01f) {
    float count = 0.0f;
    for (int i = 2; i < n; i++) {
        float diff1 = x[i-1] - x[i-2];
        float diff2 = x[i] - x[i-1];
        if ((diff1 * diff2 < 0) && (fabs(diff1) > threshold) && (fabs(diff2) > threshold)) count += 1.0f;
    }
    return count;
}

// --- Model 2 (CNN) Feature Extraction Math ---

void extract_single_channel_cnn_features(const float* ch, int n, float* out) {
    float sum_x = 0, sum_x2 = 0;
    float sum_dx = 0, sum_dx2 = 0;
    float sum_d2x2 = 0;
    float wl = 0, wl_dx = 0;
    float sum_tkeo = 0;

    for (int i = 0; i < n; i++) {
        float xi = ch[i];
        sum_x += xi;
        sum_x2 += xi * xi;

        if (i > 0) {
            float dx = xi - ch[i-1];
            sum_dx += fabs(dx);
            sum_dx2 += dx * dx;
            wl += fabs(dx);
            if (i > 1) {
                float d2x = dx - (ch[i-1] - ch[i-2]);
                sum_d2x2 += d2x * d2x;
                wl_dx += fabs(d2x);

                // Teager-Kaiser Energy Operator
                float tkeo = ch[i-1]*ch[i-1] - ch[i]*ch[i-2];
                sum_tkeo += tkeo;
            }
        }
    }

    float mean_x = sum_x / n;
    float var_x = (sum_x2 / n) - (mean_x * mean_x);
    if (var_x < 1e-8f) var_x = 1e-8f;
    float std_x = sqrt(var_x);

    // Moments
    float m0 = sum_x2 / n;
    float m2 = sum_dx2 / (n - 1);
    float m4 = sum_d2x2 / (n - 2);

    // 1-3. Root Squared Moments
    out[0] = sqrt(m0);
    out[1] = sqrt(m2);
    out[2] = sqrt(m4);

    // Normalized Moments (Skewness & Kurtosis to fulfill 10-feature array)
    float skew = 0, kurt = 0;
    for (int i = 0; i < n; i++) {
        float diff = (ch[i] - mean_x) / std_x;
        skew += diff * diff * diff;
        kurt += diff * diff * diff * diff;
    }
    // 4-5. Normalized Moments
    out[3] = skew / n;
    out[4] = kurt / n;

    // 6. Sparseness
    out[5] = m0 / (sqrt(m0 * m4) + 1e-8f);

    // 7. Irregularity Factor
    out[6] = m2 / (sqrt(m0 * m4) + 1e-8f);

    // 8. Waveform Length Ratio
    out[7] = wl / (wl_dx + 1e-8f);

    // 9. Coefficient of Variation
    out[8] = std_x / (fabs(mean_x) + 1e-8f);

    // 10. Teager-Kaiser Energy Operator (Mean TKEO)
    out[9] = sum_tkeo / (n - 2);
}

// --- Extractor Wrappers ---

void extract_rda_features(const float* ch1, const float* ch2, int n, float* out_features) {
    // 14 Features (RMS, WAMP, Log-Var, AR4 per channel)
    out_features[0] = calculate_rms(ch1, n);
    out_features[1] = calculate_wamp(ch1, n);
    out_features[2] = calculate_log_var(ch1, n);
    calculate_ar_coeffs(ch1, n, 4, &out_features[3]);

    out_features[7] = calculate_rms(ch2, n);
    out_features[8] = calculate_wamp(ch2, n);
    out_features[9] = calculate_log_var(ch2, n);
    calculate_ar_coeffs(ch2, n, 4, &out_features[10]);
}

